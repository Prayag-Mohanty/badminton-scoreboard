{
  "manifest_version": 3,
  "name": "Badminton Scoreboard for YouTube",
  "version": "1.0.0",
  "description": "Keep a BWF-style live scoreboard next to (or on top of) badminton match videos on YouTube.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Show / hide the badminton scoreboard" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/scoring.js", "lib/overlay.js", "lib/flags.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.ttf", "flags/*.svg"], "matches": ["https://www.youtube.com/*"] }
  ]
}
